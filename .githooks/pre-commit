#!/bin/sh
# Blocks a commit that contains a secret (issue #8). `make setup` turns it on.
#
# It scans what is staged with gitleaks, in the dev container. If the scan finds a secret, or can't
# run at all (no podman or docker, or the engine fails), the commit is blocked: it fails closed.
# `git commit --no-verify` skips it; CI scans every commit as the backstop.
cd "$(git rev-parse --show-toplevel)" || exit 1
if ! make --no-print-directory -s secrets-staged; then
    echo "pre-commit: commit blocked: the secret scan found a secret or could not run (see above)." >&2
    exit 1
fi
